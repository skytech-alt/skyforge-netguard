// skyforge-netguard

// ---------- ВСПОМОГАТЕЛЬНЫЕ ----------
функция разбить(строка, разделитель) {
    пусть части = []
    пусть текущая = ""
    для с в строка_символы(строка) {
        если с == разделитель {
            части = части + [текущая]
            текущая = ""
        } иначе {
            текущая = текущая + с
        }
    }
    части = части + [текущая]
    вернуть части
}

функция это_число(строка) {
    если строка == "" { вернуть ложь }
    для с в строка_символы(строка) {
        если не цифра(с) { вернуть ложь }
    }
    вернуть истина
}

// ---------- IP ----------
функция это_ipv4(значение) {
    пусть части = разбить(значение, ".")
    если длина(части) != 4 { вернуть ложь }
    для ч в части {
        если не это_число(ч) { вернуть ложь }
        пусть н = число(ч)
        если н < 0 или н > 255 { вернуть ложь }
    }
    вернуть истина
}

функция это_ip(значение) {
    вернуть это_ipv4(значение)
}

функция это_приватный(значение) {
    если не это_ipv4(значение) { вернуть ложь }
    пусть части = разбить(значение, ".")
    пусть первый = число(части[0])
    пусть второй = число(части[1])
    если первый == 10 { вернуть истина }
    если первый == 172 и второй >= 16 и второй <= 31 { вернуть истина }
    если первый == 192 и второй == 168 { вернуть истина }
    вернуть ложь
}

функция это_локальный(значение) {
    вернуть значение == "127.0.0.1"
}

// ---------- CIDR ----------
функция это_cidr(значение) {
    пусть части = разбить(значение, "/")
    если длина(части) != 2 { вернуть ложь }
    если не это_ipv4(части[0]) { вернуть ложь }
    если не это_число(части[1]) { вернуть ложь }
    пусть маска = число(части[1])
    вернуть маска >= 0 и маска <= 32
}

// ---------- MAC ----------
функция это_mac(значение) {
    пусть очищенная = ""
    для с в строка_символы(значение) {
        если с != ":" и с != "-" и с != "." {
            очищенная = очищенная + с
        }
    }
    если длина(очищенная) != 12 { вернуть ложь }
    для с в строка_символы(очищенная) {
        если не цифра(с) и не (с >= "a" и с <= "f") и не (с >= "A" и с <= "F") {
            вернуть ложь
        }
    }
    вернуть истина
}

// ---------- ПОРТ ----------
функция это_порт(значение) {
    если не это_число(строка(значение)) { вернуть ложь }
    пусть п = число(значение)
    вернуть п >= 1 и п <= 65535
}
